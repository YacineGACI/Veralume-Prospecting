# Optional. Everything works without it; with it, `prospect collect places` adds websites
# and phones from Google Maps. Stay inside the free monthly quota (cap it in the console).
# PROSPECT_GOOGLE_PLACES_KEY=
# PROSPECT_RADIUS_KM=30

# Your mailbox, to send from the app and read replies (read-only). Gmail: create an app
# password (Google account > Security > App passwords). Without these, the composer copies
# each email for your own mail app and logs it.
# PROSPECT_SMTP_HOST=smtp.gmail.com
# PROSPECT_SMTP_PORT=465
# PROSPECT_SMTP_USER=you@your-domain.fr
# PROSPECT_SMTP_PASSWORD=your-app-password
# PROSPECT_IMAP_HOST=imap.gmail.com
# PROSPECT_MAIL_FROM_NAME=Yacine · Veralume
# PROSPECT_DAILY_SEND_CAP=30
# Try everything without sending: emails are written to data/outbox/*.eml.
# PROSPECT_MAIL_DRY_RUN=true

# Writing emails from a prompt (composer and template editor). Set one or more, then pick
# one in Settings. Free: Gemini or Mistral free tier, or Ollama on this machine. Paid: Claude.
# PROSPECT_GEMINI_API_KEY=
# PROSPECT_MISTRAL_API_KEY=
# PROSPECT_OLLAMA_URL=http://localhost:11434
# PROSPECT_ANTHROPIC_API_KEY=
# Models (defaults shown):
# PROSPECT_AI_MODEL_GEMINI=gemini-2.5-flash
# PROSPECT_AI_MODEL_MISTRAL=mistral-small-latest
# PROSPECT_AI_MODEL_OLLAMA=qwen2.5:3b
# PROSPECT_AI_MODEL_CLAUDE=claude-opus-5-5
